@page "/greet-swagger"

@using Microsoft.AspNetCore.Authorization
@using BlazorAutoRendering.Api.Proxy

@inject IGreetingsApi GreetingsApi

@* @rendermode InteractiveAuto  *@
@* ^^ This always runs on the server because of prerendering. *@

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@* ^^ This forces it to run on the client. *@

@attribute [Authorize]

<PageTitle>Greet</PageTitle>

<h1>Greet</h1>

<p>This component demonstrates fetching data from a remote api.</p>

@if (_response == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Uri: @_requestUri</p>
    <p>Path: @_response.Path</p>
    <p>Message: @_response.Message</p>
    <p>Time: @_response.Time</p>
}

@code {
    private GreetingsResponse? _response = null;
    private Uri? _requestUri = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _requestUri = ((GreetingsApi)GreetingsApi).ClientBaseAddress;
            _response = await GreetingsApi.GreetAsync("catch_all");
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            Console.WriteLine(_response?.Message);
        }

    }

}
