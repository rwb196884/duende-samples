<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>

    <!-- Packages won't restore without this. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel" Version="8.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.7" />
  </ItemGroup>

  <Target Name="SwaggerPostBuildTarget" AfterTargets="Build" Outputs="$(ProjectDir)/wwwroot/GreetingsApi.json">
    <Message Importance="High" Text="Running swagger tofile (RID is $(RuntimeIdentifier))..." />
    <Exec Command="dotnet tool restore"></Exec>
    <Exec EnvironmentVariables="DOTNET_ROLL_FORWARD=LatestMajor" Command="dotnet tool run swagger tofile --output $(ProjectDir)/wwwroot/GreetingsApi.json $(ProjectDir)$(OutputPath)$(AssemblyName).dll greetings"></Exec>
  </Target>

  <Target Name="NSwagClean" AfterTargets="CoreClean">
    <Delete Files="$(ProjectDir)/wwwroot/GreetingsApi.json"></Delete>
  </Target>

</Project>
