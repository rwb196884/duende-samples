<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ApiProxyFiles Include="../BlazorAutoRendering.Api.Swaggergen/GreetingsApi.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="@(ApiProxyFiles)" Condition="'@(ApiProxyFiles)' != ''" />
    <!-- For the .Swaggergen project this doesn't work here - even though it's identical to Identity, Lite, and Portal.
    This works in VisualStudio but not in the dotnet build command or on the build server (but it does for Identity, Lite, and Portal). 
    Don't know why; the condition evaluates to false but the file is generated. 
    Therefore copy as a workaround, below. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

</Project>
